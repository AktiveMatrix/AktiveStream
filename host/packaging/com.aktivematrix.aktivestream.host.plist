<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aktivematrix.aktivestream.host</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/user/Applications/AktiveStream Host.app/Contents/MacOS/aktivestream-host</string>
        <string>serve</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/tmp/aktivestream-host.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/aktivestream-host.log</string>
</dict>
</plist>
